# Mail Platform — environment configuration (Phase 1, local development).
# Copy to .env and adjust. NEVER commit the real .env.

# --- PostgreSQL (host port 5433 avoids native PostgreSQL on 5432) ---
POSTGRES_USER=mailplatform
POSTGRES_PASSWORD=mailplatform_dev
POSTGRES_DB=mailplatform
POSTGRES_PORT=5433
DATABASE_URL=postgres://mailplatform:mailplatform_dev@localhost:5433/mailplatform?sslmode=disable

# --- Redis (host port 6380 avoids native Memurai/Redis on 6379) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- NATS JetStream ---
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# --- MinIO (S3-compatible object storage) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_REGION=us-east-1
S3_BUCKET_MAIL=mail-raw
S3_BUCKET_ATTACHMENTS=mail-attachments

# --- Go API ---
API_ADDR=:8080
# Comma-separated origins allowed by CORS (webmail dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
LOG_FORMAT=text

# --- Next.js web app ---
NEXT_PUBLIC_API_URL=http://localhost:8080
