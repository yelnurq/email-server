# Mail Platform — environment configuration (Phase 1, local development).
# Copy to .env and adjust. NEVER commit the real .env.

# --- PostgreSQL (host port 5433 avoids native PostgreSQL on 5432) ---
POSTGRES_USER=mailplatform
POSTGRES_PASSWORD=mailplatform_dev
POSTGRES_DB=mailplatform
POSTGRES_PORT=5433
DATABASE_URL=postgres://mailplatform:mailplatform_dev@localhost:5433/mailplatform?sslmode=disable

# --- Redis (host port 6380 avoids native Memurai/Redis on 6379) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- NATS JetStream ---
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# --- MinIO (S3-compatible object storage) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_REGION=us-east-1
S3_BUCKET_MAIL=mail-raw
S3_BUCKET_ATTACHMENTS=mail-attachments

# --- Go API ---
API_ADDR=:8080
# Comma-separated origins allowed by CORS (webmail dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
LOG_FORMAT=text

# --- Next.js web app ---
# Browser requests use the same-origin /backend proxy. API_INTERNAL_URL is
# read by Next.js on the server and is not exposed to the browser.
NEXT_PUBLIC_API_URL=/backend
API_INTERNAL_URL=http://localhost:8080
# Local-only quick login profiles shown on /login. Never use these defaults in production.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@company.test
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin-dev-password-1
NEXT_PUBLIC_DEMO_USER_EMAIL=user1@company.test
NEXT_PUBLIC_DEMO_USER_PASSWORD=e2e-tenantb-pass1

# --- Mail core (Stalwart) ---
# Provider: stalwart (real mail core) or none (provisioning recorded as
# skipped; local development without the container).
MAIL_CORE_PROVIDER=stalwart
STALWART_BASE_URL=http://localhost:8180
STALWART_ADMIN_USER=admin
# Placeholders — set your own values; compose falls back to dev-only defaults.
STALWART_ADMIN_PASSWORD=stalwart_dev_admin
# Master user: backend-only credential that opens any account's mailbox over
# JMAP/SMTP (unified mail store, ADR-003). Never exposed to browsers.
STALWART_MASTER_USER=master
STALWART_MASTER_PASSWORD=stalwart_dev_master
# SMTP submission endpoint the backend relays outbound mail through.
STALWART_SUBMIT_ADDR=localhost:1587
# Accept the mail core's self-signed TLS certificate (development only).
STALWART_INSECURE_TLS=true
# Host ports for the Stalwart container (docker-compose).
STALWART_SMTP_PORT=2525
STALWART_SUBMISSION_PORT=1587
STALWART_SUBMISSIONS_PORT=1465
STALWART_IMAP_PORT=1143
STALWART_IMAPS_PORT=1993
STALWART_HTTP_PORT=8180
# Connection parameters shown to users on Settings -> Mail clients.
MAIL_CLIENT_HOST=localhost
MAIL_CLIENT_SMTP_PORT=1587
MAIL_CLIENT_IMAP_PORT=1993

# --- Public platform identity (V4) ---
# Browser-facing base URL of the web app.
PUBLIC_APP_URL=http://localhost:3000
# The platform's mail host: expected MX target and PTR hostname for domains.
MAIL_HOSTNAME=mail.company.test
# Public outbound sending IP (SPF ip4 mechanism, PTR check). Leave empty in
# local development — PTR checks then report "not applicable".
OUTBOUND_IP=
# DNS server ("host:port") used by domain verification; empty = system
# resolver. Point at a controlled fixture for integration tests.
DNS_RESOLVER_ADDR=

# --- One-time bootstrap of the first admin (runs only on an empty database) ---
BOOTSTRAP_ADMIN_EMAIL=admin@company.test
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
# Set to true when serving over HTTPS
COOKIE_SECURE=false
